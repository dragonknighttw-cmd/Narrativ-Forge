# ==============================================================================
# NARRATIV-FORGE: PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Target Deployment: Render (API & Worker), Netlify/Vercel (Frontend), Expo (Mobile)
# Architecture: 100% Standalone Decoupled Video Production Studio
# Format: [Platform / Component Target] [Variable Name]=
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER — BACKEND API (Core Web Service)
# ------------------------------------------------------------------------------
# Render — Backend API	APP_ENV
APP_ENV=production

# Render — Backend API	PORT
PORT=8001

# Render — Backend API	FRONTEND_BASE_URL
FRONTEND_BASE_URL=https://narrativ-forge.netlify.app

# Render — Backend API	CORS_ORIGINS
CORS_ORIGINS=https://narrativ-forge.netlify.app,https://narrativ-forge.vercel.app

# Render — Backend API	CORS_EXTRA_ORIGINS
CORS_EXTRA_ORIGINS=

# Render — Backend API	TRUSTED_HOSTS
TRUSTED_HOSTS=narrativ-forge-api.onrender.com,localhost,127.0.0.1

# Render — Backend API	SESSION_SECRET (Generate with: openssl rand -hex 32)
SESSION_SECRET=

# Render — Backend API	SESSION_COOKIE_NAME
SESSION_COOKIE_NAME=nf_session

# Render — Backend API	SESSION_COOKIE_SECURE
SESSION_COOKIE_SECURE=true

# Render — Backend API	SESSION_TTL_SECONDS
SESSION_TTL_SECONDS=28800

# Render — Backend API	OAUTH_ENCRYPTION_KEY (Generate with: openssl rand -base64 32)
OAUTH_ENCRYPTION_KEY=

# Render — Backend API	DATABASE_URL (PostgreSQL pooled connection string)
DATABASE_URL=

# Render — Backend API	REDIS_URL (Upstash Redis or Render Native Redis)
REDIS_URL=

# Render — Backend API	SENTRY_DSN
SENTRY_DSN=

# Render — Backend API	SENTRY_ENVIRONMENT
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. RENDER — MULTI-STORAGE MATRIX (Supabase, Backblaze B2, Cloudinary, Local)
# ------------------------------------------------------------------------------
# Render — Storage	STORAGE_PROVIDER (hybrid, supabase, b2, cloudinary, local)
STORAGE_PROVIDER=hybrid

# Render — Storage	UPLOAD_DIR
UPLOAD_DIR=./storage/uploads

# Render — Storage	MAX_UPLOAD_SIZE_BYTES (50MB default)
MAX_UPLOAD_SIZE_BYTES=52428800

# Render — Storage	UPLOAD_CHUNK_SIZE_BYTES (8MB)
UPLOAD_CHUNK_SIZE_BYTES=8388608

# Render — Storage	UPLOAD_SESSION_TTL_SECONDS
UPLOAD_SESSION_TTL_SECONDS=86400

# Render — Storage	SUPABASE_URL
SUPABASE_URL=

# Render — Storage	SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=

# Render — Storage	SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Render — Storage	SUPABASE_OWNER_USER_ID
SUPABASE_OWNER_USER_ID=

# Render — Storage	SUPABASE_OWNER_EMAIL
SUPABASE_OWNER_EMAIL=

# Render — Storage	SUPABASE_OWNER_ORGANIZATION_SLUG
SUPABASE_OWNER_ORGANIZATION_SLUG=narrativ-workspace

# Render — Storage	SUPABASE_STORAGE_BUCKET
SUPABASE_STORAGE_BUCKET=narrativ-forge

# Render — Storage	SUPABASE_SIGNED_URL_EXPIRY_SECONDS
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

# Render — Storage	STORAGE_REPLICA_PROVIDER
STORAGE_REPLICA_PROVIDER=b2

# Render — Storage	STORAGE_REPLICA_ENABLED
STORAGE_REPLICA_ENABLED=true

# Render — Storage	CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# Render — Storage	CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# Render — Storage	CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# Render — Storage	CLOUDINARY_FOLDER
CLOUDINARY_FOLDER=narrativ-forge

# Render — Storage	CLOUDINARY_CHUNK_SIZE_BYTES
CLOUDINARY_CHUNK_SIZE_BYTES=20971520

# Render — Storage	B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY_ID=

# Render — Storage	B2_APPLICATION_KEY
B2_APPLICATION_KEY=

# Render — Storage	B2_BUCKET_NAME
B2_BUCKET_NAME=narrativ-forge-vault

# Render — Storage	B2_REGION
B2_REGION=us-west-004

# Render — Storage	B2_ENDPOINT_URL
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Render — Storage	B2_SIGNED_URL_EXPIRY_SECONDS
B2_SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# 3. RENDER — MULTI-PROVIDER AI FAILOVER CASCADE (Free-Tier Optimized)
# ------------------------------------------------------------------------------
# Render — AI Providers	OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Render — AI Providers	OPENROUTER_BASE_URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Render — AI Providers	OPENROUTER_MODELS
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,meta-llama/llama-3.3-70b-instruct:free

# Render — AI Providers	GEMINI_API_KEY
GEMINI_API_KEY=

# Render — AI Providers	GEMINI_BASE_URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Render — AI Providers	GEMINI_MODEL
GEMINI_MODEL=gemini-2.5-flash

# Render — AI Providers	GEMINI_FREE_TIER_ENABLED
GEMINI_FREE_TIER_ENABLED=true

# Render — AI Providers	GROQ_API_KEY
GROQ_API_KEY=

# Render — AI Providers	GROQ_BASE_URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Render — AI Providers	GROQ_MODEL
GROQ_MODEL=llama-3.3-70b-versatile

# Render — AI Providers	GROQ_FREE_TIER_ENABLED
GROQ_FREE_TIER_ENABLED=true

# Render — AI Providers	MISTRAL_API_KEY
MISTRAL_API_KEY=

# Render — AI Providers	MISTRAL_BASE_URL
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Render — AI Providers	MISTRAL_MODEL
MISTRAL_MODEL=mistral-small-latest

# Render — AI Providers	MISTRAL_FREE_TIER_ENABLED
MISTRAL_FREE_TIER_ENABLED=true

# Render — AI Providers	COHERE_API_KEY
COHERE_API_KEY=

# Render — AI Providers	COHERE_BASE_URL
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# Render — AI Providers	COHERE_MODEL
COHERE_MODEL=command-r-08-2024

# Render — AI Providers	COHERE_FREE_TIER_ENABLED
COHERE_FREE_TIER_ENABLED=true

# Render — AI Providers	NVIDIA_API_KEY
NVIDIA_API_KEY=

# Render — AI Providers	NVIDIA_BASE_URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Render — AI Providers	NVIDIA_MODEL
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Render — AI Providers	NVIDIA_FREE_TIER_ENABLED
NVIDIA_FREE_TIER_ENABLED=true

# Render — AI Providers	OPENAI_API_KEY
OPENAI_API_KEY=

# Render — AI Providers	OPENAI_BASE_URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Render — AI Providers	OPENAI_MODEL
OPENAI_MODEL=gpt-4o-mini

# Render — AI Providers	HUGGINGFACE_API_KEY
HUGGINGFACE_API_KEY=

# Render — AI Providers	AI_PROVIDER_TIMEOUT_SECONDS
AI_PROVIDER_TIMEOUT_SECONDS=45

# Render — AI Providers	PROVIDER_QUOTA_WARNING_THRESHOLD
PROVIDER_QUOTA_WARNING_THRESHOLD=0.80

# Render — AI Providers	PROVIDER_QUOTA_FALLBACK_THRESHOLD
PROVIDER_QUOTA_FALLBACK_THRESHOLD=0.95

# Render — AI Providers	VOYAGE_API_KEY
VOYAGE_API_KEY=

# ------------------------------------------------------------------------------
# 4. RENDER — CLOUDFLARE WHISPER / WORKERS AI (Burmese ASR & Speech)
# ------------------------------------------------------------------------------
# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_AI_MODEL
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_AI_FREE_TIER_ENABLED
CLOUDFLARE_AI_FREE_TIER_ENABLED=true

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_WORKER_URL
CLOUDFLARE_WHISPER_WORKER_URL=

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_SHARED_SECRET
CLOUDFLARE_WHISPER_SHARED_SECRET=

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_TOKEN_TTL_SECONDS
CLOUDFLARE_WHISPER_TOKEN_TTL_SECONDS=300

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_DAILY_NEURON_BUDGET
CLOUDFLARE_WHISPER_DAILY_NEURON_BUDGET=10000

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_WARNING_THRESHOLD
CLOUDFLARE_WHISPER_WARNING_THRESHOLD=0.80

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_FALLBACK_THRESHOLD
CLOUDFLARE_WHISPER_FALLBACK_THRESHOLD=0.95

# Render — Cloudflare Whisper / Workers AI	CLOUDFLARE_WHISPER_NEURONS_PER_AUDIO_MINUTE
CLOUDFLARE_WHISPER_NEURONS_PER_AUDIO_MINUTE=41.14

# Render — Cloudflare Whisper / Workers AI	WHISPER_REMOTE_ENABLED
WHISPER_REMOTE_ENABLED=true

# Render — Cloudflare Whisper / Workers AI	WHISPER_REMOTE_TIMEOUT_SECONDS
WHISPER_REMOTE_TIMEOUT_SECONDS=60.0

# Render — Cloudflare Whisper / Workers AI	AGNES_DAILY_SECONDS_BUDGET
AGNES_DAILY_SECONDS_BUDGET=500

# Render — Cloudflare Whisper / Workers AI	GROQ_DAILY_REQUESTS_BUDGET
GROQ_DAILY_REQUESTS_BUDGET=1000

# ------------------------------------------------------------------------------
# 5. RENDER — QDRANT VECTOR SEARCH & EMBEDDINGS
# ------------------------------------------------------------------------------
# Render — Qdrant	QDRANT_API_KEY
QDRANT_API_KEY=

# Render — Qdrant	QDRANT_CLUSTER_ENDPOINT
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io

# Render — Qdrant	QDRANT_COLLECTION_NAME
QDRANT_COLLECTION_NAME=narrativ_forge_vault

# ------------------------------------------------------------------------------
# 6. RENDER — UPSTASH QSTASH & REDIS (Task Queues & Webhooks)
# ------------------------------------------------------------------------------
# Render — Upstash QStash	QSTASH_URL
QSTASH_URL=https://qstash.upstash.io

# Render — Upstash QStash	QSTASH_TOKEN
QSTASH_TOKEN=

# Render — Upstash QStash	QSTASH_CURRENT_SIGNING_KEY
QSTASH_CURRENT_SIGNING_KEY=

# Render — Upstash QStash	QSTASH_NEXT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=

