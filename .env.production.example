# ==============================================================================
# Narrativ-Forge: Production Environment Configuration (.env.production)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` (or load it in your process manager like systemd/pm2).
# 2. Fill in all required keys before starting backend and frontend servers.
# 3. DO NOT commit the filled `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=production
# Base URL of the deployed frontend
FRONTEND_BASE_URL=https://studio.yourdomain.com
# Allowed CORS origins for FastAPI (comma-separated, no wildcards in production)
CORS_ORIGINS=https://studio.yourdomain.com
CORS_EXTRA_ORIGINS=
# Host header security (comma-separated allowed domain hosts)
TRUSTED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret (e.g. `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
# 32-byte encryption key for OAuth tokens (e.g. `openssl rand -base64 32`)
OAUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCRYPTION_KEY

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL connection string (URL-encode special characters in password)
# Example Supabase pooled URL: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@your-db-host:5432/narrativ_forge_prod?sslmode=require
# Redis connection URL (required for Celery asynchronous processing workers)
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTH & CLOUD STORAGE
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable Anon Key (for browser/frontend auth integration)
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
# Service Role Secret Key (Server-side ONLY; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
# Initial tenant/owner admin account in Supabase Auth
SUPABASE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
SUPABASE_OWNER_EMAIL=owner@yourdomain.com
SUPABASE_OWNER_ORGANIZATION_SLUG=production-workspace
SUPABASE_STORAGE_BUCKET=narrativ-forge
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

# Optional secondary storage replica (Backblaze B2 / Cloudinary)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. MULTI-PROVIDER AI FAILOVER ENGINE (Ordered from fastest/best tuned)
# ------------------------------------------------------------------------------
# Priority 1: Google Gemini Flash (Primary Burmese Script & Chat Generation)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER_ENABLED=false

# Priority 2: Groq High-Throughput (Fast Failover & Transcription)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FREE_TIER_ENABLED=false

# Priority 3: Cloudflare Workers AI (Llama-3.1 & Whisper STT)
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_AI_TOKEN
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_FREE_TIER_ENABLED=false
CLOUDFLARE_WHISPER_WORKER_URL=https://whisper.your-account.workers.dev
CLOUDFLARE_WHISPER_SHARED_SECRET=REPLACE_WITH_WHISPER_SECRET
WHISPER_REMOTE_ENABLED=true

# Priority 4: Cohere (Multilingual Fallback)
COHERE_API_KEY=REPLACE_WITH_COHERE_API_KEY
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-r-08-2024
COHERE_FREE_TIER_ENABLED=false

# Priority 5: OpenRouter (Multi-model Gateway)
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free

# Priority 6: NVIDIA NIM
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FREE_TIER_ENABLED=false

# Vector Embeddings (512-D Zero-Reindex Fallback: Voyage-3-lite -> Cohere)
VOYAGE_API_KEY=REPLACE_WITH_VOYAGE_API_KEY

AI_PROVIDER_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 6. NATIVE DIRECT TELEGRAM ALERT (Automated 429 & Quota Exhaustion Alerts)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_SUPERGROUP_ID
TELEGRAM_TOPIC_ID=REPLACE_WITH_NARRATIV_FORGE_TOPIC_ID
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------------
# 7. SENTRY ERROR OBSERVABILITY
# ------------------------------------------------------------------------------
SENTRY_DSN=REPLACE_WITH_NARRATIV_FORGE_SENTRY_DSN
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 8. FRONTEND BROWSER CLIENT (Next.js Public Variables)
# ------------------------------------------------------------------------------
# Points the client browser to the public FastAPI endpoint
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
