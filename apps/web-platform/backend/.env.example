APP_ENV=development
# SQLite for local development; use a PostgreSQL URL for staging/production.
# URL-encode reserved characters in database credentials.
DATABASE_URL=sqlite:///./narrativ_forge.db
# Optional; only required by code paths that explicitly use Redis.
# REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=development-only-change-this-secret
SENTRY_DSN=
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=false
PORT=8001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# Optional comma-separated origins appended to CORS_ORIGINS for deployed frontends.
CORS_EXTRA_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
# Telegram Bot & Topic Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_ENABLED=false
STORAGE_PROVIDER=local
SUPABASE_URL=
# Public/publishable key; safe for browser use. Never put the service-role key in frontend variables.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# First Owner identity must match the verified Supabase Auth user UUID and email.
SUPABASE_OWNER_USER_ID=
SUPABASE_OWNER_EMAIL=
SUPABASE_OWNER_ORGANIZATION_SLUG=legacy-workspace
SUPABASE_STORAGE_BUCKET=narrativ-forge
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT_URL=
B2_SIGNED_URL_EXPIRY_SECONDS=900
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=narrativ-forge
CLOUDINARY_CHUNK_SIZE_BYTES=20971520
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
IDEMPOTENCY_TTL_SECONDS=86400


# Hybrid production routing: video/audio -> B2, thumbnails/covers -> Cloudinary, small text/assets -> Supabase Storage.
# Optional asynchronous replica. Cloudinary and B2 are supported.
# STORAGE_REPLICA_ENABLED=false
# STORAGE_REPLICA_PROVIDER=b2

# OAuth / email delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/google/callback
OAUTH_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=


# AI chat-provider failover. Keep all keys in runtime/GitHub secret stores, never in Git.
# OpenRouter is first and restricted to exact allowlisted :free chat models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free
# Non-OpenRouter providers are skipped unless their key is present AND the corresponding
# *_FREE_TIER_ENABLED=true flag is explicitly set after confirming account/model limits.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FREE_TIER_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FREE_TIER_ENABLED=false
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-r-08-2024
COHERE_FREE_TIER_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FREE_TIER_ENABLED=false
# OpenAI settings remain available for unrelated experiments; this content route never uses them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_SECONDS=45

# Cloudflare Workers AI Whisper offload
CLOUDFLARE_WHISPER_WORKER_URL=
CLOUDFLARE_WHISPER_SHARED_SECRET=
# Optional chat fallback: a separate Workers AI API token + Cloudflare account ID.
# Do not copy CLOUDFLARE_WHISPER_SHARED_SECRET into CLOUDFLARE_API_TOKEN.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_FREE_TIER_ENABLED=false
CLOUDFLARE_WHISPER_TOKEN_TTL_SECONDS=300
CLOUDFLARE_WHISPER_DAILY_NEURON_BUDGET=10000
CLOUDFLARE_WHISPER_WARNING_THRESHOLD=0.80
CLOUDFLARE_WHISPER_FALLBACK_THRESHOLD=0.95
WHISPER_REMOTE_ENABLED=true
WHISPER_REMOTE_TIMEOUT_SECONDS=60
CLOUDFLARE_WHISPER_NEURONS_PER_AUDIO_MINUTE=41.14
# Subtitle input is Unicode Burmese only; strings are normalized with Unicode NFC.
SUBTITLE_NORMALIZATION_MODE=unicode_nfc_only
