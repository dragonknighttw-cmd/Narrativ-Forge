{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "instructions": [
    "AGENTS.md",
    "README.md",
    "CURRENT_STATE.md",
    "ROADMAP.md",
    "TOOL.md"
  ],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current": "allow",
      "git push*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "question": "allow"
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git push*": "deny"
        }
      }
    }
  }
}
