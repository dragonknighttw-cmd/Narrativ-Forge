APP_ENV=development
# SQLite for local development; use a PostgreSQL URL for staging/production.
# URL-encode reserved characters in database credentials.
DATABASE_URL=sqlite:///./narrativ_forge.db
# Optional; only required by code paths that explicitly use Redis.
# REDIS_URL=redis://localhost:6379/0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production: remove bootstrap secrets after creating the first owner
SESSION_SECRET=development-only-change-this-secret
SENTRY_DSN=
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
IDEMPOTENCY_TTL_SECONDS=86400
STORJ_ACCESS_KEY_ID=
STORJ_SECRET_ACCESS_KEY=
STORJ_BUCKET_NAME=
STORJ_REGION=global
STORJ_ENDPOINT_URL=https://gateway.storjshare.io
STORJ_SIGNED_URL_EXPIRY_SECONDS=900
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/google/callback
OAUTH_ENCRYPTION_KEY=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WHISPER_COMMAND=whisper
WHISPER_MODEL=small
PROCESSING_TIMEOUT_SECONDS=3600
PROCESSING_TIMEOUT_GRACE_SECONDS=10
WORKER_MAX_CONCURRENCY=1
