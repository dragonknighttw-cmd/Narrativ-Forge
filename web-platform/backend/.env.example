APP_ENV=development
# SQLite for local development; use a PostgreSQL URL for staging/production.
# URL-encode reserved characters in database credentials.
DATABASE_URL=sqlite:///./narrativ_forge.db
# Optional; only required by code paths that explicitly use Redis.
# REDIS_URL=redis://localhost:6379/0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production: remove bootstrap secrets after creating the first owner
SESSION_SECRET=development-only-change-this-secret
SENTRY_DSN=
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=narrativ-forge
CLOUDINARY_CHUNK_SIZE_BYTES=20971520
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
IDEMPOTENCY_TTL_SECONDS=86400


# Optional asynchronous replica. Cloudinary and B2 are supported.
# STORAGE_REPLICA_ENABLED=false
# STORAGE_REPLICA_PROVIDER=b2

# OAuth / email delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/google/callback
OAUTH_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
