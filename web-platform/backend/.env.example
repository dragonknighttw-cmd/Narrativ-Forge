APP_ENV=development
# SQLite for local development; use a PostgreSQL URL for staging/production.
# URL-encode reserved characters in database credentials.
DATABASE_URL=sqlite:///./narrativ_forge.db
# Optional; only required by code paths that explicitly use Redis.
# REDIS_URL=redis://localhost:6379/0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production: remove bootstrap secrets after creating the first owner
SESSION_SECRET=development-only-change-this-secret
SENTRY_DSN=
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=narrativ-forge
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT_URL=
B2_SIGNED_URL_EXPIRY_SECONDS=900
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=narrativ-forge
CLOUDINARY_CHUNK_SIZE_BYTES=20971520
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
IDEMPOTENCY_TTL_SECONDS=86400


# Hybrid production routing: video/audio -> B2, thumbnails/covers -> Cloudinary, small text/assets -> Supabase Storage.
# Optional asynchronous replica. Cloudinary and B2 are supported.
# STORAGE_REPLICA_ENABLED=false
# STORAGE_REPLICA_PROVIDER=b2

# OAuth / email delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/google/callback
OAUTH_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=


# Optional AI text providers. Real secrets belong in runtime environment configuration.
# Production content generation is OpenRouter free-only; Groq/OpenAI keys are not used by this route.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_SECONDS=45

# Cloudflare Workers AI Whisper offload
CLOUDFLARE_WHISPER_WORKER_URL=
CLOUDFLARE_WHISPER_SHARED_SECRET=
CLOUDFLARE_WHISPER_TOKEN_TTL_SECONDS=300
CLOUDFLARE_WHISPER_DAILY_NEURON_BUDGET=10000
CLOUDFLARE_WHISPER_WARNING_THRESHOLD=0.80
CLOUDFLARE_WHISPER_FALLBACK_THRESHOLD=0.95
WHISPER_REMOTE_ENABLED=true
WHISPER_REMOTE_TIMEOUT_SECONDS=60
CLOUDFLARE_WHISPER_NEURONS_PER_AUDIO_MINUTE=41.14
