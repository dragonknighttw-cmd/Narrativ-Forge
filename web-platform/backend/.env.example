APP_ENV=development
DATABASE_URL=sqlite:///./narrativ_forge.db
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production: remove bootstrap secrets after creating the first owner
SESSION_SECRET=development-only-change-this-secret
SESSION_COOKIE_NAME=nf_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
# Optional; defaults to https://s3.<B2_REGION>.backblazeb2.com
B2_ENDPOINT_URL=
B2_SIGNED_URL_EXPIRY_SECONDS=900
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/google/callback
OAUTH_ENCRYPTION_KEY=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WHISPER_COMMAND=whisper
WHISPER_MODEL=small
PROCESSING_TIMEOUT_SECONDS=3600
